# Copie para deploy/vps/app.env e preencha. NUNCA envie app.env para o GitHub.

# ---- Usados na construção (build) do painel ----
VITE_SUPABASE_URL=https://api.aagencianext.com
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_A_ANON_KEY_DO_SEU_SUPABASE

# ---- Servidor de dados (do ~/supabase/docker/.env) ----
SUPABASE_URL=https://api.aagencianext.com
SUPABASE_PUBLISHABLE_KEY=COLE_A_ANON_KEY_DO_SEU_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_DO_SEU_SUPABASE

# ---- Endereço público do painel (rotinas chamam este endereço) ----
APP_BASE_URL=https://aagencianext.com
SITE_URL=https://aagencianext.com

# ---- Segredo das rotinas automáticas (gere com: openssl rand -hex 32) ----
# Tem que ser o MESMO valor usado no passo sql/01 (cron_secret).
WA_CRON_SECRET=

# ---- Meta / WhatsApp (pegar no painel de desenvolvedor da Meta) ----
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
META_JS_SDK_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
BM_1047578338203627_SYSTEM_USER_TOKEN=
# PIN de 6 dígitos para registrar números novos automaticamente (opcional)
META_ES_REGISTER_PIN=

# ---- Geolocalização de cliques (conta IP-API) ----
IP_API_KEY=

# ---- Google Agenda (Google Cloud Console → Credenciais) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Só usado pela agenda via conector da Lovable; fora dela pode ficar vazio
GOOGLE_CALENDAR_API_KEY=

# ---- IA (Auditoria de rastreamento e análise de campanha) ----
# Fora da Lovable use uma chave própria compatível com OpenAI.
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1

# ---- Ferramenta interna de teste do WhatsApp (deixe desligado em produção) ----
WA_HARNESS_ENABLED=0
WA_HARNESS_TOKEN=
